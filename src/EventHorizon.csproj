<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.17.3</Version>
    <AssemblyName>EventHorizon</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../assets/icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/relay-defaults.json" Link="relay-defaults.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/fonts/*" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
