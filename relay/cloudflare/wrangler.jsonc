{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-horizon-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "build": { "command": "node prepare-fonts.mjs" },
  "assets": { "directory": "../../assets/fonts/shared", "binding": "FONTS", "run_worker_first": true },
  "browser": { "binding": "BROWSER" },
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "EventRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventRelay"] }],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf", "**/*.png"], "fallthrough": true }],
  "observability": { "enabled": false }
}
